# String de conexao do Postgres (Neon). Com ela definida, o backend persiste
# os agendamentos no banco (e ganha a protecao anti-sobreposicao no nivel do
# banco); sem ela, cai para um repositorio em memoria — bom para dev local e
# testes, mas os dados somem a cada reinicio do servidor.
# Pegue a string em: painel do Neon -> seu projeto -> Connection Details.
# Ja vem com "?sslmode=require" no final, como o Neon exige.
# Depois de definir, rode: npm run migrate  (cria a tabela "bookings")
DATABASE_URL=

# Porta do servidor HTTP
PORT=5000

# Origem permitida para CORS (URL do frontend Next.js)
FRONTEND_URL=http://localhost:3000

# Provider de mensageria:
#   whatsapp-web -> automacao real via sessao do WhatsApp (QR Code), producao completa
#   none         -> sem automacao; sempre mostra o link manual wa.me ao cliente (producao simples, sem Chromium)
#   mock         -> finge sucesso e so loga no console (use isso apenas em desenvolvimento local/testes)
MESSAGING_PROVIDER=mock

# Numero de WhatsApp da barbearia (E.164, sem "+"), usado em links de fallback wa.me
BARBERSHOP_WHATSAPP_NUMBER=5511999999999

# Horas de antecedencia para disparo do lembrete automatico
REMINDER_HOURS_BEFORE=2

# Numero (E.164 sem "+") que recebe a notificacao de "novo agendamento" quando
# o barbeiro atribuido nao tem telefone proprio cadastrado em config/barbers.js
ADMIN_WHATSAPP_NUMBER=5511999999999

# --- Login do painel administrativo (uso interno da barbearia) ---
ADMIN_USERNAME=admin
# Gere com: npm run hash-password -- "sua-senha-aqui"  (rode dentro da pasta backend/)
ADMIN_PASSWORD_HASH=
# String aleatoria longa e secreta — troque antes de ir para producao
JWT_SECRET=troque-por-uma-string-aleatoria-longa-e-unica
JWT_EXPIRES_IN=12h
